shamefully-hoist=true

# Native modules are materialized as real directories instead of links into
# pnpm's content-addressable store. Several React Native libraries (notably
# @react-native-masked-view/masked-view, pulled in by expo-router) rewrite
# their own AndroidManifest.xml from build.gradle at configuration time; the
# store is read-only, so linking them fails the Android build outright.
# `inject-workspace-packages` applies the real-copy layout to workspace
# dependencies as well, keeping every module the Gradle build touches writable.
node-linker=hoisted
